<Project>
  <!--
    This file is imported automatically when MSBuild evaluates PicoGK/PicoGK.csproj.
    Only the superproject's pack job enables PicoGKLegacyPack.
    Normal builds of the PicoGK source submodule remain unchanged.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PicoGK' And '$(PicoGKLegacyPack)' == 'true'">
    <!-- Replace the two historical binary payloads declared in PicoGK.csproj. -->
    <None Remove="native/osx-arm64/*.dylib;native/win-x64/*.dll" />

    <!-- Add only the freshly compiled native libraries downloaded by CI. -->
    <None Include="$(MSBuildThisFileDirectory)build-legacy/artifacts/runtimes/osx-arm64/native/*.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="$(MSBuildThisFileDirectory)build-legacy/artifacts/runtimes/win-x64/native/*.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>
</Project>
